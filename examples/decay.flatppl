%%%
# Infer an exponential decay rate

Three noisy measurements constrain the decay rate of a population starting at one.
%%%
flatppl_compat = "0.1"
ode = load_module("https://raw.githubusercontent.com/BJMCox/flatppl-numerics-ode/main/main.flatppl")
times_data = [0.0, 0.5, 1.0]
y_data = [1.02, 0.57, 0.38]
rate ~ LogNormal(0, 0.5)
rhs = (t, y, p) -> -p .* y
states = ode.vern7(rhs, [1.0], times_data, rate)
response ~ Normal.(rowstack(states)[:, 1], 0.05)
prior = lawof(rate)
forward = kernelof(response, rate = rate)
L = likelihoodof(forward, y_data)
Pi_post = bayesupdate(L, prior)
