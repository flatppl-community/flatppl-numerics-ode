%%%
# Refine the grid for exponential decay inference

This is the playground decay model in log-rate coordinates. The observation
times and Gaussian noise scale are fixed. Compare three Vern7 grids with the
exact flow.
%%%
flatppl_compat = "0.1"
ode = load_module("../main.flatppl")
observation_times = [0.0, 0.5, 1.0]
observed = [1.02, 0.57, 0.38]
sigma = 0.05
times_coarse = linspace(0.0, 1.0, 3)
times_medium = linspace(0.0, 1.0, 5)
times_fine = linspace(0.0, 1.0, 9)
rhs = (t, y, rate) -> -rate .* y
trajectory = (log_rate, times) -> ode.vern7_with_error(rhs, [1.0], times, exp(log_rate))
means = (log_rate, times, rows) -> rowstack(ode.vern7(rhs, [1.0], times, exp(log_rate)))[rows, 1]
log_rate ~ Normal(0.0, 0.5)
observations_coarse ~ Normal.(means(log_rate, times_coarse, [1, 2, 3]), sigma)
observations_medium ~ Normal.(means(log_rate, times_medium, [1, 3, 5]), sigma)
observations_fine ~ Normal.(means(log_rate, times_fine, [1, 5, 9]), sigma)
observations_exact ~ Normal.(exp.(-exp(log_rate) .* observation_times), sigma)
prior = lawof(record(log_rate = log_rate))
Pi_coarse = bayesupdate(
  likelihoodof(kernelof(observations_coarse, log_rate = log_rate), observed),
  prior,
)
Pi_medium = bayesupdate(
  likelihoodof(kernelof(observations_medium, log_rate = log_rate), observed),
  prior,
)
Pi_post = bayesupdate(
  likelihoodof(kernelof(observations_fine, log_rate = log_rate), observed),
  prior,
)
Pi_exact = bayesupdate(
  likelihoodof(kernelof(observations_exact, log_rate = log_rate), observed),
  prior,
)
probe = elementof(reals)
point = record(log_rate = probe)
score_coarse = logdensityof(Pi_coarse, point)
score_medium = logdensityof(Pi_medium, point)
score_fine = logdensityof(Pi_post, point)
score_exact = logdensityof(Pi_exact, point)
coarse_errors = rowstack(trajectory(probe, times_coarse).error)
medium_errors = rowstack(trajectory(probe, times_medium).error)
fine_errors = rowstack(trajectory(probe, times_fine).error)
inputs = probe
outputs = (
  score_coarse,
  score_medium,
  score_fine,
  score_exact,
  coarse_errors,
  medium_errors,
  fine_errors,
)
