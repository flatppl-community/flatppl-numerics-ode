%%%
# Fixed-grid ordinary differential equations

Integrate dy/dt = f(t, y, p), with a length-d vector state and explicit parameters p.
A strictly monotone length-N time grid gives an N-by-d trajectory, including the
initial state. Specialized solvers cover affine flows and second-order mechanics.
%%%
flatppl_compat = "0.1"
explicit = load_module("src/explicit.flatppl")
stiff = load_module("src/stiff.flatppl")
grid = load_module("src/solve.flatppl")
verlet = load_module("src/verlet.flatppl")
affine_flow = load_module("src/affine.flatppl")
rodas = load_module("src/rodas4p2.flatppl")
euler_step = explicit.euler_step
heun_step = explicit.heun_step
rk4_step = explicit.rk4_step
vern7_step = explicit.vern7_step
rosenbrock23_step = stiff.rosenbrock23_step
sdirk2_step = stiff.sdirk2_step
euler = (f, initial, times, p) -> grid.solve(euler_step, f, initial, times, p)
heun = (f, initial, times, p) -> grid.solve(heun_step, f, initial, times, p)
rk4 = (f, initial, times, p) -> grid.solve(rk4_step, f, initial, times, p)
vern7 = (f, initial, times, p) -> grid.solve(vern7_step, f, initial, times, p)
vern7_step_with_error = explicit.vern7_step_with_error
vern7_with_error = (f, initial, times, p) -> grid.solve_with_error(vern7_step_with_error, f, initial, times, p)
rosenbrock23 = (f, initial, times, p) -> grid.solve(rosenbrock23_step, f, initial, times, p)
sdirk2 = (f, initial, times, p) -> grid.solve(sdirk2_step, f, initial, times, p)
sdirk2_residual = stiff.sdirk2_residual
rosenbrock23_analytic_step = stiff.rosenbrock23_analytic_step
sdirk2_analytic_step = stiff.sdirk2_analytic_step
sdirk2_analytic_residual = stiff.sdirk2_analytic_residual
_rosenbrock23_step = (f, t, y, h, args) -> rosenbrock23_analytic_step(f, args[1], args[2], t, y, h, args[3])
_sdirk2_step = (f, t, y, h, args) -> sdirk2_analytic_step(f, args[1], t, y, h, args[2])
rosenbrock23_analytic = (f, jac, dfdt, initial, times, p) -> grid.solve(_rosenbrock23_step, f, initial, times, (jac, dfdt, p))
sdirk2_analytic = (f, jac, initial, times, p) -> grid.solve(_sdirk2_step, f, initial, times, (jac, p))
velocity_verlet_step = verlet.velocity_verlet_step
velocity_verlet = verlet.velocity_verlet
affine_step = affine_flow.affine_step
affine = affine_flow.affine
rodas4p2_step = rodas.rodas4p2_step
rodas4p2 = (f, jac, dfdt, initial, times, p) -> grid.solve(rodas.rodas4p2_grid_step, f, initial, times, (jac, dfdt, p))
rodas4p2_step_with_error = rodas.rodas4p2_step_with_error
rodas4p2_with_error = (f, jac, dfdt, initial, times, p) -> grid.solve_with_error(rodas.rodas4p2_grid_step_with_error, f, initial, times, (jac, dfdt, p))
